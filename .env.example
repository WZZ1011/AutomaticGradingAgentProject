# 沙箱（core/sandbox）配置示例。
# 用法：cp .env.example .env，再按本机情况修改。
# .env 已被 .gitignore 排除，不会被提交。
#
# 镜像必须自带 bash、g++、GNU coreutils，且**部署机要预先拉取**：
#   docker pull gcc:13
# 容器固定用 --pull=never，缺镜像会直接报基础设施错误，不会临时去仓库拉。
SANDBOX_IMAGE=gcc:13

# 超时与资源限制（数字型变量配错会直接抛 ValueError，不会静默退回默认值）
SANDBOX_COMPILE_TIMEOUT=30
SANDBOX_RUN_TIMEOUT=10
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64

# 输出上限（字节）
SANDBOX_OUTPUT_LIMIT=65536
SANDBOX_COMPILE_OUTPUT_LIMIT=65536
